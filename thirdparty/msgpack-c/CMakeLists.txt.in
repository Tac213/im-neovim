cmake_minimum_required(VERSION 3.16)

project(msgpack-c-download NONE)

include(ExternalProject)

# Avoid warning about DOWNLOAD_EXTRACT_TIMESTAMP in CMake 3.24:
if (CMAKE_VERSION VERSION_GREATER_EQUAL "3.24.0")
  cmake_policy(SET CMP0135 NEW)
endif()

ExternalProject_Add(msgpack-c
  URL               https://github.com/msgpack/msgpack-c/archive/refs/tags/cpp-7.0.0.tar.gz
  SOURCE_DIR        "${CMAKE_CURRENT_BINARY_DIR}/msgpack-c-src"
  BINARY_DIR        "${CMAKE_CURRENT_BINARY_DIR}/msgpack-c-build"
  CONFIGURE_COMMAND ""
  BUILD_COMMAND     ""
  INSTALL_COMMAND   ""
  TEST_COMMAND      ""
)
